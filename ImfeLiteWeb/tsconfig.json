{
  //  https://github.com/facebook/create-react-app/issues/5683

  "compilerOptions": {
    "noImplicitAny": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": true,
    "target": "es5",
    "lib": [
      "es2018",
      "dom"
    ]
  },
  "exclude": [
    "wwwroot",
    "node_modules",
    "dist",
    "lib",
    "lib-amd"
  ]


}